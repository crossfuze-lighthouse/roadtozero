{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/data/**",
              "components/forms/**",
              "components/layout/**",
              "components/patterns/**",
              "ui_kits/marketing/**",
              "ui_kits/tools/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Source Sans 3))/i]",
        "message": "Font not provided by the design system. Available: Source Sans 3."
      },
      {
        "selector": "JSXOpeningElement[name.name='Bluf'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|tone|children|style|key|ref|className|style|children)$/]",
        "message": "<Bluf> doesn't accept that prop. Declared props: label, tone, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Bluf'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:dark|light)$/]",
        "message": "<Bluf> tone must be one of 'dark' | 'light'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|arrow|disabled|href|onClick|children|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, arrow, disabled, href, onClick, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|ghost|outline)$/]",
        "message": "<Button> variant must be one of 'primary' | 'ghost' | 'outline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|lg)$/]",
        "message": "<Button> size must be one of 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CalcMeta'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|key|ref|className|style|children)$/]",
        "message": "<CalcMeta> doesn't accept that prop. Declared props: label, value."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|hoverable|padding|children|style|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: tone, hoverable, padding, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:light|dark)$/]",
        "message": "<Card> tone must be one of 'light' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ChatBubble'] > JSXAttribute > JSXIdentifier[name!=/^(?:from|meta|children|style|key|ref|className|style|children)$/]",
        "message": "<ChatBubble> doesn't accept that prop. Declared props: from, meta, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ChatBubble'] > JSXAttribute[name.name='from'] > Literal[value!=/^(?:otto|user)$/]",
        "message": "<ChatBubble> from must be one of 'otto' | 'user'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|children|style|key|ref|className|style|children)$/]",
        "message": "<Eyebrow> doesn't accept that prop. Declared props: tone, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:utility|green|cyan|purple|red|midnight|white)$/]",
        "message": "<Eyebrow> tone must be one of 'utility' | 'green' | 'cyan' | 'purple' | 'red' | 'midnight' | 'white'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FaqItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:question|bluf|children|style|key|ref|className|style|children)$/]",
        "message": "<FaqItem> doesn't accept that prop. Declared props: question, bluf, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='GradientText'] > JSXAttribute > JSXIdentifier[name!=/^(?:gradient|children|style|key|ref|className|style|children)$/]",
        "message": "<GradientText> doesn't accept that prop. Declared props: gradient, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='GradientText'] > JSXAttribute[name.name='gradient'] > Literal[value!=/^(?:vibrant|calm|storm)$/]",
        "message": "<GradientText> gradient must be one of 'vibrant' | 'calm' | 'storm'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Hero'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|style|key|ref|className|style|children)$/]",
        "message": "<Hero> doesn't accept that prop. Declared props: children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|tone|size|basePath|alt|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, tone, size, basePath, alt, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:midnight|bright-blue|vibrant)$/]",
        "message": "<Icon> tone must be one of 'midnight' | 'bright-blue' | 'vibrant'."
      },
      {
        "selector": "JSXOpeningElement[name.name='OptionCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:index|label|meta|selected|onClick|style|key|ref|className|style|children)$/]",
        "message": "<OptionCard> doesn't accept that prop. Declared props: index, label, meta, selected, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Pill'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|children|style|key|ref|className|style|children)$/]",
        "message": "<Pill> doesn't accept that prop. Declared props: tone, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Pill'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:green|cyan|purple|red|midnight)$/]",
        "message": "<Pill> tone must be one of 'green' | 'cyan' | 'purple' | 'red' | 'midnight'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProgressBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|style|key|ref|className|style|children)$/]",
        "message": "<ProgressBar> doesn't accept that prop. Declared props: value, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ScoreBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|sublabel|score|max|style|key|ref|className|style|children)$/]",
        "message": "<ScoreBar> doesn't accept that prop. Declared props: label, sublabel, score, max, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ScoreTile'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|sub|band|valueSize|style|key|ref|className|style|children)$/]",
        "message": "<ScoreTile> doesn't accept that prop. Declared props: label, value, sub, band, valueSize, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ScoreTile'] > JSXAttribute[name.name='band'] > Literal[value!=/^(?:low|mid|high|neutral)$/]",
        "message": "<ScoreTile> band must be one of 'low' | 'mid' | 'high' | 'neutral'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Section'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|narrow|id|children|style|innerStyle|key|ref|className|style|children)$/]",
        "message": "<Section> doesn't accept that prop. Declared props: tone, narrow, id, children, style, innerStyle."
      },
      {
        "selector": "JSXOpeningElement[name.name='Section'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:light|grey|dark)$/]",
        "message": "<Section> tone must be one of 'light' | 'grey' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FooterColumn'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|links|key|ref|className|style|children)$/]",
        "message": "<FooterColumn> doesn't accept that prop. Declared props: title, links."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|label|key|ref|className|style|children)$/]",
        "message": "<NavItem> doesn't accept that prop. Declared props: id, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='Stat'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|tone|size|style|key|ref|className|style|children)$/]",
        "message": "<Stat> doesn't accept that prop. Declared props: value, label, tone, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Stat'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:light|dark)$/]",
        "message": "<Stat> tone must be one of 'light' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Stat'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|lg)$/]",
        "message": "<Stat> size must be one of 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextInput'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|type|value|onChange|onKeyDown|placeholder|id|style|key|ref|className|style|children)$/]",
        "message": "<TextInput> doesn't accept that prop. Declared props: tone, type, value, onChange, onKeyDown, placeholder, id, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextInput'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:dark|light)$/]",
        "message": "<TextInput> tone must be one of 'dark' | 'light'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TrackCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|tone|title|body|items|ctaLabel|ctaHref|style|key|ref|className|style|children)$/]",
        "message": "<TrackCard> doesn't accept that prop. Declared props: label, tone, title, body, items, ctaLabel, ctaHref, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TrackCard'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:green|purple)$/]",
        "message": "<TrackCard> tone must be one of 'green' | 'purple'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
